<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Engine.Windowed</RootNamespace>
    <AssemblyName>DeltaEngine.Windowed</AssemblyName>
    <PackageId>DeltaEngine.Windowed</PackageId>
    <RuntimeIdentifiers>osx-arm64;win-x64;linux-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeltaEngine.Integration\DeltaEngine.Integration.csproj" />
    <ProjectReference Include="..\..\..\DeltaXAML\src\DeltaXAML.Contract\DeltaXAML.Contract.csproj" />
    <ProjectReference Include="..\..\..\DeltaMaths\DeltaMaths.csproj" />
    <ProjectReference Include="..\..\..\DeltaShader\src\DeltaShader.Contract\DeltaShader.Contract.csproj" />
    <ProjectReference Include="..\..\..\DeltaRender\src\DeltaRender\DeltaRender.csproj" />
    <ProjectReference Include="..\..\..\DeltaRender\src\DeltaRender.Platform.SDL3\DeltaRender.Platform.SDL3.csproj" />
    <ProjectReference Include="..\..\..\DeltaRender\src\DeltaRender.Vulkan\DeltaRender.Vulkan.csproj" />
    <ProjectReference Include="..\..\..\DeltaRender\tools\DeltaRender.FullscreenShaders\DeltaRender.FullscreenShaders.csproj" />
    <ProjectReference Include="..\..\..\DeltaRender\tools\DeltaRender.UiShaders\DeltaRender.UiShaders.csproj" />
    <PackageReference Include="SDL3-CS" Version="3.4.12.6" />
    <PackageReference Include="Silk.NET.MoltenVK.Native" Version="2.23.0" GeneratePathProperty="true" />
    <Content Include="$(PkgSilk_NET_MoltenVK_Native)/runtimes/osx/native/libMoltenVK.dylib" Condition=" '$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64' ">
      <Link>libMoltenVK.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(PkgSilk_NET_MoltenVK_Native)/runtimes/osx/native/MoltenVK_icd.json" Condition=" '$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64' ">
      <Link>MoltenVK_icd.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\DeltaRender\samples\DeltaRender.Smoke\shaders\fullscreen-rounded-rectangle.vert.spv" Link="shaders\fullscreen-rounded-rectangle.vert.spv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\DeltaRender\samples\DeltaRender.Smoke\shaders\fullscreen-rounded-rectangle.frag.spv" Link="shaders\fullscreen-rounded-rectangle.frag.spv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\DeltaRender\samples\DeltaRender.Smoke\shaders\ui-panel.vert.spv" Link="shaders\ui-panel.vert.spv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\DeltaRender\samples\DeltaRender.Smoke\shaders\ui-panel.frag.spv" Link="shaders\ui-panel.frag.spv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
