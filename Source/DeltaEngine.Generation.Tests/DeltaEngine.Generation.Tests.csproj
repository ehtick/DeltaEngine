  <ItemGroup>
    <ProjectReference Include="..\DeltaEngine.Generation\DeltaEngine.Generation.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DeltaEngine.Generation.Core\DeltaEngine.Generation.Core.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
