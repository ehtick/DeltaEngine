<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DeltaEngine.Generation.Tests</RootNamespace>
    <AssemblyName>DeltaEngine.Generation.Tests</AssemblyName>
    <PackageId>DeltaEngine.Generation.Tests</PackageId>
    <DefineConstants>$(DefineConstants);DELTA_GEN_ATTRIBUTES;GLCSharp_GEN_ATTRIBUTES</DefineConstants>
